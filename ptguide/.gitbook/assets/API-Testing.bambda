// ============================================================
// HELPER FUNCTION: URL Encode payload based on parameter type
// Defined as a BiFunction since Bambda does not allow standalone methods
// ============================================================
java.util.function.BiFunction<String, burp.api.montoya.http.message.params.HttpParameterType, String> encodePayload = (payload, paramType) -> {
    try {
        if (paramType == burp.api.montoya.http.message.params.HttpParameterType.URL) {
            return java.net.URLEncoder.encode(payload, "UTF-8");
        }
        return payload;
    } catch (Exception e) {
        logging().logToError("Error encoding payload: " + e.getMessage());
        return payload;
    }
};

