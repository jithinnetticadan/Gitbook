// ============================================================
// Category 9: Response Analysis - Security Headers Check (PER-REQUEST)
// ============================================================
logging().logToOutput("[ === Category 9a: Security Headers Analysis === ]");
try {
    var httpRequestResponse = api().http().sendRequest(originalRequest);
    Thread.sleep(GLOBAL_DELAY_MS);
    
    StringBuilder headerAnalysis = new StringBuilder();
    headerAnalysis.append("[Cat9a] Security Headers Analysis:\n");
    
    for (String header : SECURITY_HEADERS_TO_CHECK) {
        String headerValue = httpRequestResponse.response().headerValue(header);
        if (headerValue != null) {
            headerAnalysis.append("  " + header + ": " + headerValue + "\n");
            
            // Flag potentially bad headers
            if (header.equals("X-Powered-By") || header.equals("Server") || 
                header.equals("X-AspNet-Version") || header.equals("X-AspNetMvc-Version")) {
                logging().logToOutput("[ALERT] Information Disclosure: " + header + " = " + headerValue);
            }
            
            // Check CORS headers for misconfiguration
            if (header.equals("Access-Control-Allow-Origin") && headerValue.equals("*")) {
                logging().logToOutput("[ALERT] Wildcard CORS detected: " + headerValue);
            }
            if (header.equals("Access-Control-Allow-Credentials") && headerValue.equals("true")) {
                logging().logToOutput("[ALERT] CORS with credentials enabled");
            }
        } else {
            headerAnalysis.append("  " + header + ": MISSING\n");
            
            // Flag missing security headers
            if (header.equals("X-Content-Type-Options") || header.equals("X-Frame-Options") ||
                header.equals("Content-Security-Policy") || header.equals("Strict-Transport-Security")) {
                logging().logToOutput("[ALERT] Missing Security Header: " + header);
            }
        }
    }
    
    String result = headerAnalysis.toString();
    logging().logToOutput(result);
    
    httpRequestResponse.annotations().setNotes("[Cat9a] Security Headers Analysis");
    api().organizer().sendToOrganizer(httpRequestResponse);
    results.append(result + "\n");
    totalRequests++;
    
    // Check for sensitive data in response body
    String responseBody = httpRequestResponse.response().bodyToString().toLowerCase();
    for (String pattern : SENSITIVE_DATA_PATTERNS) {
        if (responseBody.contains(pattern.toLowerCase())) {
            logging().logToOutput("[ALERT] Potential sensitive data in response: " + pattern);
            results.append("[ALERT] Potential sensitive data: " + pattern + "\n");
        }
    }
    
} catch (Exception e) {
    logging().logToError("Error with Security Headers Analysis: " + e.getMessage());
}

// ============================================================
// Category 9c: Cookie Security Analysis (PER-REQUEST)
// ============================================================
logging().logToOutput("[ === Category 9c: Cookie Security Analysis === ]");
try {
    var httpRequestResponse = api().http().sendRequest(originalRequest);
    Thread.sleep(GLOBAL_DELAY_MS);
    
    java.util.List<String> setCookieHeaders = new java.util.ArrayList<>();
    for (burp.api.montoya.http.message.HttpHeader header : httpRequestResponse.response().headers()) {
        if (header.name().equalsIgnoreCase("Set-Cookie")) {
            setCookieHeaders.add(header.value());
        }
    }
    
    if (!setCookieHeaders.isEmpty()) {
        StringBuilder cookieAnalysis = new StringBuilder();
        cookieAnalysis.append("[Cat9c] Cookie Security Analysis:\n");
        
        for (String cookie : setCookieHeaders) {
            cookieAnalysis.append("  Cookie: " + cookie + "\n");
            
            String cookieLower = cookie.toLowerCase();
            
            // Check for Secure flag
            if (!cookieLower.contains("secure")) {
                logging().logToOutput("[ALERT] Cookie missing Secure flag: " + cookie.split(";")[0]);
                cookieAnalysis.append("    [ALERT] Missing Secure flag\n");
            }
            
            // Check for HttpOnly flag
            if (!cookieLower.contains("httponly")) {
                logging().logToOutput("[ALERT] Cookie missing HttpOnly flag: " + cookie.split(";")[0]);
                cookieAnalysis.append("    [ALERT] Missing HttpOnly flag\n");
            }
            
            // Check for SameSite attribute
            if (!cookieLower.contains("samesite")) {
                logging().logToOutput("[ALERT] Cookie missing SameSite attribute: " + cookie.split(";")[0]);
                cookieAnalysis.append("    [ALERT] Missing SameSite attribute\n");
            }
            
            // Check for session/persistent cookie (no Expires or Max-Age = session cookie)
            if (cookieLower.contains("expires") || cookieLower.contains("max-age")) {
                logging().logToOutput("[INFO] Persistent cookie detected: " + cookie.split(";")[0]);
                cookieAnalysis.append("    [INFO] Persistent cookie detected\n");
            }
        }
        
        String result = cookieAnalysis.toString();
        logging().logToOutput(result);
        
        httpRequestResponse.annotations().setNotes("[Cat9c] Cookie Security Analysis");
        api().organizer().sendToOrganizer(httpRequestResponse);
        results.append(result + "\n");
    } else {
        logging().logToOutput("[INFO] No Set-Cookie headers in response");
    }
    
    totalRequests++;
    
} catch (Exception e) {
    logging().logToError("Error with Cookie Security Analysis: " + e.getMessage());
}

